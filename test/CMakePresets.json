{
    "version": 6,
    "configurePresets": [
        {
            "name": "generic-32",
            "hidden": true,
            "generator": "Ninja",
            "toolchainFile": "${sourceDir}/../../toolchain-gnu/generic-32.cmake",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "TRUE"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug (Generic-32, Ninja)",
            "inherits": "generic-32",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "displayName": "Release (Generic-32, Ninja)",
            "inherits": "generic-32",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        }
    ]
}
